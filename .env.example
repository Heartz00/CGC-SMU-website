# Public read-only WordPress content. No WordPress credentials required.
WORDPRESS_URL=https://blog.smu.edu/chemgrads
# Public endpoints verified during development. Set false for an offline preview.
WORDPRESS_ENABLED=true
# Optional alternative: https://blog.smu.edu/chemgrads/?rest_route=/wp/v2/
WORDPRESS_API_URL=https://blog.smu.edu/chemgrads/wp-json/wp/v2/
WORDPRESS_OFFICERS_SLUG=officers
WORDPRESS_MANAGED_OFFICERS_SLUG=cgc-officers
WORDPRESS_EVENTS_SLUG=events
# Set the production URL to enable canonical metadata and sitemap.
# SITE_URL=https://your-project.vercel.app

# Optional dashboard. Keep disabled until an encryption key is configured.
ADMIN_ENABLED=false
NEXT_PUBLIC_SITE_METRICS_ENABLED=false
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store only in .env.local and Vercel's server environment, never NEXT_PUBLIC_*.
# ADMIN_SESSION_SECRET=your-generated-base64-key

# Private student forum. Enable only after applying the migration and setting up email.
FORUM_ENABLED=false
# All forum requests go through the server. Never expose the secret/service key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-project-publishable-or-anon-key
# SUPABASE_SECRET_KEY=your-project-secret-or-service-role-key
